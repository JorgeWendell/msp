# Copie este arquivo para .env no servidor antes de subir os containers:
#   cp .env.docker.example .env
#
# Troque senhas e o domínio. O banco Docker começa vazio
# (volume novo). Para zerar de novo: docker compose down -v

# PostgreSQL (container Docker — adelmsp-db)
# Evite @ : / ? # na senha — ela entra na DATABASE_URL.
POSTGRES_USER=adelmsp
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=adelmsp

# App + Traefik
APP_DOMAIN=msp.adelweb.com.br
BETTER_AUTH_SECRET=troque_por_um_secret_longo_e_aleatorio
BETTER_AUTH_URL=https://msp.adelweb.com.br
NEXT_PUBLIC_BASE_URL=https://msp.adelweb.com.br
VAULT_SECRET=

# Traefik (igual ao ERP / eventos / fsnext3)
TRAEFIK_NETWORK=proxy

# MeshCentral continua no host (não vai neste compose).
# O iframe do remoto abre esta URL no navegador do técnico.
MESHCENTRAL_URL=https://192.168.15.12:4443
MESHCENTRAL_AGENT_WSS=wss://192.168.15.12:4443/agent.ashx
MESHCENTRAL_MESH_NAME=AdelMsp
MESHCENTRAL_MESH_ID=0xC3DB35784E25D8EA618687C8A90E93FBED835A6DA894F849D3590DB5E04E9248F254D0CD585D4F8D1E593EBC7849F095
MESHCENTRAL_SERVER_ID=9ABAC673FB984F09A1EA583D43811053C4EEAE0031D7078AA1B0301A9D3E5D0C650365A5CED05C612F7FAC6C7FB37B63
MESHCENTRAL_USER=suporte
MESHCENTRAL_PASS=
MESHCENTRAL_AGENT_PATH=private/mesh/AdelMsp.Remote.exe
